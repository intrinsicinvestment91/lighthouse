{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lighthouse.local/schemas/public_source_targets.v1.schema.json",
  "title": "public_source_targets.v1",
  "description": "The operator's declared work list of public locators to check (LHP-INTEL-04B). It is NOT a trust boundary: it has no field in which a host could be authorized. Reference mirror only \u2014 the authoritative enforcer is modules.public_source_check.load_targets().",
  "type": "object",
  "required": [
    "schema_version",
    "targets"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "public_source_targets.v1"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "locator"
        ],
        "additionalProperties": false,
        "properties": {
          "locator": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    }
  }
}
