# -----------------------------------------------------------------------
# Project Lighthouse — environment variables
# Copy this file to .env and fill in your values.
# -----------------------------------------------------------------------

# Patent provider. Options: disabled, legacy_patentsview, odp
# Default is disabled: search.patentsview.org is decommissioned; no confirmed ODP replacement yet.
PATENT_PROVIDER=disabled

# Legacy PatentsView Search API base URL (currently known stale — DNS fails as of 2026-05).
PATENTSVIEW_BASE_URL=https://search.patentsview.org/api/v1

# USPTO Open Data Portal base URL for future ODP adapter (leave blank until adapter implemented).
USPTO_ODP_BASE_URL=

# Optional API key if required by the active patent provider.
PATENTSVIEW_API_KEY=

# Free registration at https://patentscope.wipo.int/patentscope/en/programs/create_account.jsf
WIPO_API_KEY=your_wipo_api_key_here

# 64-character hex secp256k1 private key scalar for Nostr signing.
# Generate once with:
#   python -c "
#   from cryptography.hazmat.primitives.asymmetric.ec import generate_private_key, SECP256K1
#   from cryptography.hazmat.backends import default_backend
#   k = generate_private_key(SECP256K1(), default_backend())
#   print(k.private_bytes_raw().hex())
#   "
NOSTR_PRIVATE_KEY_HEX=your_64char_hex_secp256k1_scalar_here
NOSTR_PUBLISH_CORRELATIONS=false

# SEC EDGAR User-Agent. SEC asks automated clients to declare an organization name and a contact
# email. No default: the SEC sentinel refuses to run (and sends no requests) while this is unset
# or has no contact email. Set your own value, for example:
# SEC_USER_AGENT=Example Org admin@example.org
SEC_USER_AGENT=

# IPFS API endpoint. Defaults to a local Kubo daemon.
# Alternatives: /dns4/host.docker.internal/tcp/5001  or a Pinata/web3.storage HTTP URL.
IPFS_API_URL=/ip4/127.0.0.1/tcp/5001

# Directories under which `lighthouse observe` is permitted to look (os.pathsep-separated —
# ":" on Linux). This is the AUTHORITATIVE trust boundary for local observation intake: a
# repository or document is observable only if it resolves inside one of these roots, symlink
# escape included.
#
# Empty (the default) means NOTHING is observable and `lighthouse observe` refuses to run — it
# never degrades into "no boundary, so observe anything". There is no default path and no home
# directory scan. The deployed container sets no roots and therefore observes nothing.
#
# The work list (data/observation_sources.json) may only narrow this; it can never widen it.
# LIGHTHOUSE_OBSERVATION_ROOTS=/home/you/Projects:/home/you/Documents
